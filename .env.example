# ============================================================
# TaskFlow Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# Generate secrets with the commands shown below.

# -- Database --------------------------------------------------
# PostgreSQL connection string
DATABASE_URL="postgresql://taskuser:CHANGE_ME@localhost:5432/taskmanagement"

# Test database (separate DB for running tests safely)
TEST_DATABASE_URL="postgresql://taskuser:CHANGE_ME@localhost:5433/taskmanagement_test"

# -- NextAuth --------------------------------------------------
# The URL of your deployed app (no trailing slash)
NEXTAUTH_URL="https://your-domain.com"

# Strong random secret — generate with:
#   openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE_ME"

# -- Field encryption ------------------------------------------
# 32-byte key stored as 64 hex characters — generate with:
#   openssl rand -hex 32
FIELD_ENCRYPTION_KEY="CHANGE_ME_64_HEX_CHARS"

# -- Registration allowlist ------------------------------------
# Comma-separated list of emails allowed to register.
# Leave blank to allow anyone (not recommended for private installs).
ALLOWED_REGISTRATION_EMAILS="you@example.com"

# -- Optional --------------------------------------------------
# Secret for the /api/recurring cron endpoint (protect it)
#   openssl rand -hex 16
CRON_SECRET="CHANGE_ME"

# Postgres password (used by docker-compose.prod.yml)
POSTGRES_PASSWORD="CHANGE_ME"

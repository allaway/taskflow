generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  passwordHash     String
  name             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // AI provider config (encrypted)
  aiProvider       String?  // "anthropic" | "openrouter"
  aiApiKey         String?  // AES-256-GCM encrypted
  aiModel          String?
  aiSchedulingModel String?

  // Google Calendar OAuth
  googleAccessToken  String?   // AES-256-GCM encrypted
  googleRefreshToken String?   // AES-256-GCM encrypted
  googleTokenExpiry  DateTime?
  googleEmail        String?   // connected Google account email

  // Daily work budget in hours (default 8)
  dailyBudgetHours Int     @default(8)

  // Label palette — JSON array of {name, color}
  labelPalette     String?  // JSON

  // Calendar sync timestamp
  calendarSyncedAt DateTime?

  // Claude Code Routines integration
  claudeCodeRoutineId    String?  // e.g. "routine_01HJKLMN…"
  claudeCodeRoutineToken String?  // AES-256-GCM encrypted bearer token

  tasks                Task[]
  apiTokens            ApiToken[]
  cachedCalendarEvents CachedCalendarEvent[]
  dayPlans             DayPlan[]
  threads              Thread[]
  catchUpItems         CatchUpItem[]
}

model Task {
  id            String     @id @default(cuid())
  title         String
  description   String?
  notes         String?
  status        TaskStatus @default(INBOX)
  priority      Priority   @default(MEDIUM)
  source        TaskSource @default(MANUAL)

  scheduledDate DateTime?
  startTime     String?    // "HH:MM" format
  duration      Int?       // minutes

  recurringRule String?    // cron expression e.g. "0 9 * * 1" (Mon 9am)
  externalId    String?    // for deduplication from integrations
  labels        String?    // JSON array of label names

  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  completedAt   DateTime?  // set when status → COMPLETED
  daysOverdue   Int        @default(0)  // incremented each time task slides forward
  agentQueued   Boolean    @default(false)  // task is queued for an AI agent to pick up
  parallel      Boolean    @default(false)  // worked on alongside other tasks; overlapping parallel tasks share one block of time

  threads       Thread[]

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([userId])
  @@index([userId, scheduledDate])
  @@index([userId, status])
  @@unique([userId, externalId])
}

enum TaskStatus {
  INBOX
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum TaskSource {
  MANUAL
  API
  RECURRING
}

model CachedCalendarEvent {
  id           String   @id  // "${userId}:${googleEventId}"
  userId       String
  title        String
  start        DateTime
  end          DateTime
  allDay       Boolean  @default(false)
  calendarName String
  color        String   @default("#6366f1")
  description  String?
  location     String?
  meetLink     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, start])
}

model ApiToken {
  id          String    @id @default(cuid())
  name        String
  tokenHash   String    @unique
  tokenPrefix String
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?

  @@index([userId])
}

// One row per user per day: what the user said mattered, and the plan's rationale.
model DayPlan {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String   // "YYYY-MM-DD" in the user's local calendar
  intent    String?  // the user's prompt: "what really matters today"
  summary   String?  // the planner's explanation of the plan it built
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}

// A conversation. ASSISTANT threads are the daily in-app assistant chat (one per
// day). AGENT threads are delegated work that lives under a task: either run
// in-app (provider "taskflow") or in an external tool (Claude, Codex, Gemini…)
// that is linked by URL and reports back over MCP.
model Thread {
  id             String       @id @default(cuid())
  kind           ThreadKind
  provider       String       @default("taskflow")
  title          String
  url            String?      // where the thread lives, for external providers
  externalId     String?      // provider's session/thread id
  status         ThreadStatus @default(ACTIVE)
  summary        String?      // latest one-line state of the work
  date           String?      // "YYYY-MM-DD" for ASSISTANT threads

  taskId         String?
  task           Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  messages       ThreadMessage[]

  lastActivityAt DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userId, kind, date])
  @@index([userId, kind, status])
  @@index([taskId])
}

enum ThreadKind {
  ASSISTANT
  AGENT
}

enum ThreadStatus {
  ACTIVE   // the agent is working
  WAITING  // the agent is waiting on the user
  DONE
}

model ThreadMessage {
  id        String   @id @default(cuid())
  threadId  String
  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role      String   // "user" | "agent" | "system" (tool activity, status changes)
  content   String
  createdAt DateTime @default(now())

  @@index([threadId, createdAt])
}

// Catch-up: things that happened elsewhere (email, Slack, agent threads…) that
// the user triages into tasks or archives. Not a task until triaged.
model CatchUpItem {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  source     String        // "email" | "slack" | "agent" | "calendar" | free-form
  title      String
  body       String?
  url        String?
  author     String?
  externalId String?       // for deduplication from integrations
  occurredAt DateTime      @default(now())
  status     CatchUpStatus @default(NEW)
  relevance  Int           @default(50)  // 0–100
  reason     String?       // why it was ranked where it was
  taskId     String?       // set when triaged into a task
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([userId, externalId])
  @@index([userId, status, relevance])
}

enum CatchUpStatus {
  NEW
  TASKED
  ARCHIVED
}
